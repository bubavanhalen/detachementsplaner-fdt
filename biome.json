{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": [
      "src/**",
      "tests/**/*.ts",
      "tests/**/*.tsx",
      "tools/**/*.mjs",
      "*.json",
      "*.ts",
      "!!src/vendor",
      "!!package-lock.json",
      "!!test-results",
      "!!dist",
      "!!node_modules"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "single" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noConsole": "error" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
