{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "src/**",
      "tests/**/*.ts",
      "tests/**/*.tsx",
      "tools/**/*.mjs",
      "tools/wap/**",
      "scripts/wap*/**/*.mjs",
      "*.json",
      "*.ts",
      "!!src/vendor",
      "!!package-lock.json",
      "!!test-results",
      "!!dist",
      "!!node_modules"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "single" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noConsole": "error" }
    }
  },
  "overrides": [
    {
      "includes": [
        "src/model/wap/**",
        "src/io/wap-plan/**",
        "src/io/wap-pdf/**",
        "src/io/wap-import/**",
        "src/io/wap-persons/**",
        "src/io/xlsx-drawing/**",
        "src/components/wap/**",
        "src/pages/WapPage.tsx",
        "src/assets/wap-fonts/**",
        "tests/wap/**",
        "tests/wap-e2e/**",
        "tests/wap-perf/**",
        "tests/wap-gate/**",
        "tools/wap/**",
        "scripts/wap*/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noFocusedTests": "error",
            "noSkippedTests": "error",
            "noExplicitAny": "error"
          }
        }
      }
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
