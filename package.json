{
  "name": "wk-util-suite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Offline-first PISA service planning and contact export",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "biome format --write .",
    "lint": "biome check .",
    "check": "npm run typecheck && npm run lint && npm test",
    "build": "npm run typecheck && node tools/build-offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check:release": "node tools/verify-release.mjs",
    "wap:harness:test": "vitest run -c vitest.wap-harness.config.ts",
    "wap:gate:fast": "node scripts/wap-gate/gate.mjs fast",
    "wap:gate:full": "node scripts/wap-gate/gate.mjs full",
    "wap:gate:selftest": "node scripts/wap-gate/selftest.mjs",
    "wap:gate:stability": "node scripts/wap-gate/stability.mjs",
    "wap:test": "vitest run -c vitest.wap.config.ts",
    "wap:test:gate": "vitest run -c vitest.wap-gate.config.ts",
    "wap:test:e2e": "node scripts/wap-gate/e2e.mjs",
    "wap:test:visual": "node scripts/wap-gate/e2e.mjs --project chromium-visual",
    "wap:test:perf": "node scripts/wap-gate/e2e.mjs --project perf",
    "wap:einzeldatei": "node scripts/wap-gate/einzeldatei.mjs",
    "wap:trace": "node scripts/wap-gate/trace.mjs --mode full",
    "wap:test:golden": "vitest run -c vitest.wap-golden.config.ts",
    "wap:golden:aufnahme": "node scripts/wap-gate/golden-aufnahme.mjs",
    "wap:golden:bericht": "node scripts/wap-gate/golden-report.mjs --vorher-ref HEAD --out test-results/wap/golden/bericht",
    "wap:test:coverage": "node scripts/wap-gate/coverage-check.mjs",
    "wap:test:mutation": "node scripts/wap-gate/mutation.mjs",
    "wap:lizenzen": "node scripts/wap-gate/license-check.mjs",
    "test:reference": "vitest run -c vitest.wap-reference.config.ts",
    "test:oracle": "python -m unittest discover -s tests -p test_*.py"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "ast-v8-to-istanbul": "1.0.7",
    "axe-core": "4.13.0",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.10.2",
    "jsdom": "30.1.3",
    "monocart-coverage-reports": "2.13.0",
    "pdfjs-dist": "6.3.289",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-store": "0.11.2",
    "@tanstack/react-table": "9.3.1",
    "@xyflow/react": "12.12.0",
    "fflate": "0.8.3",
    "fontkit": "2.0.4",
    "hyphen": "1.14.1",
    "immer": "11.1.18",
    "motion": "14.4.0",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "license": "MIT"
}
