{
  "name": "detachementsplaner-fdt",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Offline-first PISA service planning and contact export",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "biome format --write .",
    "lint": "biome check .",
    "check": "npm run typecheck && npm run lint && npm test",
    "build": "npm run typecheck && node tools/build-offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check:release": "node tools/verify-release.mjs",
    "test:oracle": "python -m unittest discover -s tests -p test_*.py"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-store": "0.11.1",
    "@tanstack/react-table": "9.2.4",
    "@xyflow/react": "12.11.6",
    "motion": "13.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "license": "MIT"
}
